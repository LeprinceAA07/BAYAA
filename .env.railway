# Railway-specific reference for the BAYAA service environment variables.
#
# This file documents the EXACT variable names Railway must expose for the
# /pricing page (src/pricing/main.jsx) to work. Each variable must be set as
# its own, individual key in Railway's service Variables tab.
#
# IMPORTANT: Do NOT paste all of the variable names as a single multi-line
# value under one key. Doing so creates a malformed variable with embedded
# newlines (e.g. a single "BAYAA_PADDLE_CLIENT_TOKEN" key whose value is the
# literal text of every other variable name), which breaks the environment
# variable namespace and prevents Vite from resolving BAYAA_PADDLE_* values
# at build time. This was the root cause of the "Missing Paddle price IDs"
# error on the pricing page.
#
# vite.config.js exposes both VITE_ and BAYAA_ prefixed variables to the
# client bundle via import.meta.env, so these must be set as plain BAYAA_*
# variables (no VITE_ prefix required, though VITE_ prefixed duplicates are
# also fine).

# Sandbox Paddle integration — required
BAYAA_PADDLE_ENVIRONMENT=sandbox
BAYAA_PADDLE_CLIENT_TOKEN=test_replace_with_paddle_client_token

# Seller plan price IDs — required, one variable per plan/period
BAYAA_PADDLE_STARTER_MONTH_PRICE_ID=pri_replace_with_starter_month_price_id
BAYAA_PADDLE_STARTER_YEAR_PRICE_ID=pri_replace_with_starter_year_price_id
BAYAA_PADDLE_PRO_MONTH_PRICE_ID=pri_replace_with_pro_month_price_id
BAYAA_PADDLE_PRO_YEAR_PRICE_ID=pri_replace_with_pro_year_price_id
BAYAA_PADDLE_ADVANCED_MONTH_PRICE_ID=pri_replace_with_advanced_month_price_id
BAYAA_PADDLE_ADVANCED_YEAR_PRICE_ID=pri_replace_with_advanced_year_price_id
