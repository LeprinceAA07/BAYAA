# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Paddle Billing for seller subscriptions
# Use sandbox values for testing, then replace with live values after Paddle approval.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=test_replace_with_paddle_client_token
PADDLE_API_KEY=replace_with_paddle_api_key
PADDLE_WEBHOOK_SECRET=replace_with_paddle_notification_secret
PADDLE_PRO_PRICE_ID=pri_replace_with_pro_price_id
PADDLE_BUSINESS_PRICE_ID=pri_replace_with_business_price_id

# Legacy/local provider settings are not used for seller card billing.
MOOSYL_PUBLISHABLE_KEY=pk_sandbox_replace_me
MOOSYL_SECRET_KEY=sk_sandbox_replace_me
MOOSYL_WEBHOOK_SECRET=replace-with-moosyl-webhook-secret

# BAYAA admin/monetization
ADMIN_EMAIL=admin@example.com
DEFAULT_COMMISSION_RATE=0.05
PUBLIC_BASE_URL=https://your-bayaa-domain.example
PORT=3000
