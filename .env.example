# Server
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
PORT=3000
PUBLIC_BASE_URL=https://your-bayaa-domain.example

# Paddle server-side verification / webhooks (never expose API key or webhook secret to the client)
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=replace_with_paddle_api_key
PADDLE_WEBHOOK_SECRET=replace_with_paddle_notification_secret

# BAYAA Paddle.js pricing page
# Sandbox client-side token must start with test_. Never hard-code a token in source code.
BAYAA_PADDLE_ENVIRONMENT=sandbox
BAYAA_PADDLE_CLIENT_TOKEN=test_replace_with_paddle_client_token
BAYAA_PADDLE_STARTER_MONTH_PRICE_ID=pri_01m2ar5a0w2na3cnyvkw2cpxkf
BAYAA_PADDLE_STARTER_YEAR_PRICE_ID=pri_01m2as32ksj20php6kb7yf4xpq
BAYAA_PADDLE_PRO_MONTH_PRICE_ID=pri_replace_with_pro_month_price_id
BAYAA_PADDLE_PRO_YEAR_PRICE_ID=pri_replace_with_pro_year_price_id
BAYAA_PADDLE_ADVANCED_MONTH_PRICE_ID=pri_01m2akjt05j7qyb15gkq9wa57n
BAYAA_PADDLE_ADVANCED_YEAR_PRICE_ID=pri_01m2as03jjytyr6z5k3ge79hkt

# Existing seller billing configuration used by BAYAA's seller billing widget
PADDLE_CLIENT_TOKEN=test_replace_with_paddle_client_token
PADDLE_PRO_PRICE_ID=pri_replace_with_pro_price_id
PADDLE_BUSINESS_PRICE_ID=pri_replace_with_business_price_id

# Admin / monetization
ADMIN_EMAIL=admin@example.com
DEFAULT_COMMISSION_RATE=0.05
