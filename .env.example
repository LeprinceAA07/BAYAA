# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Optional: set false only when your PostgreSQL provider does not require SSL
DATABASE_SSL=true
# Replace this in production with a long random secret
JWT_SECRET=replace-with-a-long-random-secret
# Optional comma-separated frontend origins
CLIENT_ORIGIN=http://localhost:5173
# Moosyl is kept for local Mauritanian wallet integrations; do not use it for Visa/Mastercard seller billing
MOOSYL_PUBLISHABLE_KEY=pk_sandbox_replace_me
MOOSYL_SECRET_KEY=sk_sandbox_replace_me
MOOSYL_WEBHOOK_SECRET=replace-with-moosyl-webhook-secret
# Seller billing: Hosted Visa/Mastercard gateway (GIMTEL/bank or compatible Mastercard Gateway)
CARD_GATEWAY_BASE_URL=https://replace-with-your-bank-or-gimtel-gateway
CARD_GATEWAY_MERCHANT_ID=replace-with-merchant-id
CARD_GATEWAY_API_PASSWORD=replace-with-api-password
CARD_GATEWAY_API_VERSION=100
CARD_GATEWAY_CURRENCY=MRU
CARD_GATEWAY_MERCHANT_NAME=BAYAA
CARD_GATEWAY_RETURN_URL=https://your-bayaa-domain.example/seller-billing.html
# Optional custom checkout URL template using {sessionId}, {version}, {merchantId}
CARD_GATEWAY_CHECKOUT_URL=
# BAYAA admin/monetization
ADMIN_EMAIL=admin@example.com
DEFAULT_COMMISSION_RATE=0.05
# Public base URL used when no explicit card return URL is provided
PUBLIC_BASE_URL=https://your-bayaa-domain.example
# Railway/Render/etc. sets PORT automatically
PORT=3000
