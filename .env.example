# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Optional: set false only when your PostgreSQL provider does not require SSL
DATABASE_SSL=true
# Replace this in production with a long random secret
JWT_SECRET=replace-with-a-long-random-secret
# Optional comma-separated frontend origins
CLIENT_ORIGIN=http://localhost:5173
# Railway/Render/etc. sets PORT automatically
PORT=3000
